    "gsap": "^3.15.0",
    "hyperframes": "^0.6.30",
    "next": "^16.0.3",
    "puppeteer": "^24.43.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "undici": "^8.4.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
