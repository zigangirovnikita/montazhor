DATABASE_URL="file:/app/storage/prisma/dev.db"
STORAGE_ROOT="/app/storage"
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
WHISPER_PYTHON="/usr/bin/python3"
TRANSCRIPTION_PROVIDER="whisperx"
WHISPER_MODEL="medium"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"
WHISPERX_BATCH_SIZE="8"
WHISPERX_DIARIZE="true"
WHISPER_VAD_FILTER="false"
WHISPER_INITIAL_PROMPT="Это русская разговорная речь для короткого видео. Сохраняй междометия, паузы, слова-паразиты и вокализации: эээ, эм, ммм, ааа, ну, короче."
HYPERFRAMES_BIN="npx hyperframes"
# In docker-compose production the app container cannot safely run HyperFrames --docker
# against the host daemon because generated project paths live under /app/storage.
# Use the bundled Chrome directly, with software rendering and one render at a time.
HYPERFRAMES_RENDER_MODE="local"
PRODUCER_BROWSER_GPU_MODE="software"
PRODUCER_MAX_CONCURRENT_RENDERS="1"
PUPPETEER_CACHE_DIR="/app/storage/.cache/puppeteer"
HYPERFRAMES_NO_TELEMETRY="1"

HF_HOME="/app/storage/models/huggingface"
HUGGINGFACE_HUB_CACHE="/app/storage/models/huggingface/hub"
TORCH_HOME="/app/storage/models/torch"
PYANNOTE_CACHE="/app/storage/models/pyannote"
NLTK_DATA="/app/storage/models/nltk_data"
XDG_CACHE_HOME="/app/storage/models/.cache"
MPLCONFIGDIR="/app/storage/models/.cache/matplotlib"

VOICE_ACTIVITY_PROVIDER="pyannote"
MFA_ALIGNMENT_ENABLED="true"
MFA_ENV_ROOT="./storage/models/mfa-env"
MFA_ACOUSTIC_MODEL="russian_mfa"
MFA_DICTIONARY_MODEL="russian_mfa"
PYANNOTE_AUTH_TOKEN=""
PYANNOTE_DIARIZATION_MODEL="pyannote/speaker-diarization-3.1"

SILERO_VAD_THRESHOLD="0.5"
SILERO_VAD_MIN_SPEECH_MS="250"
SILERO_VAD_MIN_SILENCE_MS="450"
SILERO_VAD_SPEECH_PAD_MS="80"

OPENROUTER_API_KEY=""
AI_MODEL="google/gemini-3.1-flash-lite"
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_PROVIDER="openrouter"
AI_MAX_TOKENS="4096"
AI_TEMPERATURE="0.1"

KIE_API_KEY=""
KIE_AI_MODEL="gemini-3.1-pro"
KIE_AI_COMPLETIONS_URL="https://api.kie.ai/gemini-3.1-pro/v1/chat/completions"
KIE_AI_MAX_TOKENS="4096"
KIE_AI_TEMPERATURE="0.1"

SCRIPT_SELECTOR_PASS1_AI_PROVIDER="openrouter"
SCRIPT_SELECTOR_PASS2_AI_PROVIDER="openrouter"
