DATABASE_URL="file:./dev.db"
STORAGE_ROOT="./storage"
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
WHISPER_PYTHON="./.venv/bin/python"
TRANSCRIPTION_PROVIDER="stable-ts"
WHISPER_MODEL="medium"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"
WHISPERX_BATCH_SIZE="8"
WHISPERX_DIARIZE="true"
WHISPER_VAD_FILTER="false"
CRISPER_SITE_PACKAGES=""
CRISPER_MODEL_ID="nyrahealth/CrisperWhisper"
WHISPER_INITIAL_PROMPT="Это русская разговорная речь для короткого видео. Сохраняй междометия, паузы, слова-паразиты и вокализации: эээ, эм, ммм, ааа, ну, короче."
HF_HOME="./storage/models/huggingface"
HUGGINGFACE_HUB_CACHE="./storage/models/huggingface/hub"
HYPERFRAMES_BIN="npx hyperframes"

# ElevenLabs Speech-to-Text (set TRANSCRIPTION_PROVIDER="elevenlabs" to use it)
ELEVENLABS_API_KEY=""
ELEVENLABS_STT_MODEL="scribe_v2"
ELEVENLABS_PROXY_URL=""
ELEVENLABS_TIMESTAMPS_GRANULARITY="word"
ELEVENLABS_FILE_FORMAT="pcm_s16le_16"
ELEVENLABS_TEMPERATURE="0"
ELEVENLABS_SEED="9683"
ELEVENLABS_DIARIZE="false"
ELEVENLABS_TAG_AUDIO_EVENTS="true"
ELEVENLABS_NO_VERBATIM="false"

# Voice Activity Detection / Diarization
VOICE_ACTIVITY_PROVIDER="pyannote"
MFA_ALIGNMENT_ENABLED="true"
MFA_ENV_ROOT="./storage/models/mfa-env"
MFA_ACOUSTIC_MODEL="russian_mfa"
MFA_DICTIONARY_MODEL="russian_mfa"
PYANNOTE_AUTH_TOKEN=""
PYANNOTE_DIARIZATION_MODEL="pyannote/speaker-diarization-3.1"
# Optional if most videos have one visible speaker.
# PYANNOTE_MIN_SPEAKERS="1"
# PYANNOTE_MAX_SPEAKERS="2"

# Legacy fallback: used only if VOICE_ACTIVITY_PROVIDER="silero"
SILERO_VAD_THRESHOLD="0.5"
SILERO_VAD_MIN_SPEECH_MS="250"
SILERO_VAD_MIN_SILENCE_MS="450"
SILERO_VAD_SPEECH_PAD_MS="80"

# AI Edit Analysis (OpenRouter)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""
AI_MODEL="google/gemini-3.1-flash-lite"
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_PROVIDER="openrouter"
AI_MAX_TOKENS="4096"
AI_TEMPERATURE="0.1"

# Optional second AI provider (KIE OpenAI-compatible chat completions)
KIE_API_KEY=""
KIE_AI_MODEL="gemini-3.1-pro"
KIE_AI_COMPLETIONS_URL="https://api.kie.ai/gemini-3.1-pro/v1/chat/completions"
KIE_AI_MAX_TOKENS="4096"
KIE_AI_TEMPERATURE="0.1"

# Route AI tasks independently: "openrouter" or "kie"
SCRIPT_SELECTOR_PASS1_AI_PROVIDER="openrouter"
SCRIPT_SELECTOR_PASS2_AI_PROVIDER="openrouter"

# Gemini Melism Detector
GEMINI_MELISM_DETECTOR_ENABLED="true"
GEMINI_PROVIDER="openrouter"
GEMINI_BASE_URL=""
GEMINI_API_KEY=""
GEMINI_MODEL="google/gemini-3-flash-preview"
GEMINI_MELISM_AUDIO_ENABLED="true"
GEMINI_MELISM_AUDIO_MAX_BYTES="6000000"

MELISM_MIN_CONFIDENCE_AUTO_REMOVE="0.75"
MELISM_MIN_CONFIDENCE_REVIEW="0.45"
MIN_MELISM_REMOVAL_SECONDS="0.15"
MAX_MELISM_REMOVAL_SECONDS="2.0"
MELISM_KEEP_HANDLE_SECONDS="0.08"
UNTRANSCRIBED_VOICE_REQUIRES_GEMINI="true"
